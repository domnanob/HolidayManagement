@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* Required *@
<MudThemeProvider IsDarkMode="@isDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

@Body


@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    public bool isDarkMode { get; set; } = false;

}